
from tavily import TavilyClient

def main():
    print("=" * 45)
    print("       MY AI - INTERNET SEARCH")
    print("=" * 45)
    print("Пиши запитання. Для виходу введи: вихід")

    try:
        search = TavilyClient()

        while True:
            question = input("\nТи: ").strip()

            if question.lower() in ("вихід", "exit", "quit"):
                print("ШІ: До зустрічі!")
                break

            if not question:
                continue

            print("\nШІ: Шукаю інформацію в інтернеті...")

            try:
                response = search.search(
                    query=question,
                    max_results=5,
                    search_depth="basic"
                )

                results = response.get("results", [])

                if not results:
                    print("ШІ: Нічого не знайдено.")
                    continue

                print("\nШІ: Ось що вдалося знайти:\n")

                for i, item in enumerate(results, 1):
                    title = item.get("title", "Без назви")
                    content = item.get("content", "Опис відсутній")
                    url = item.get("url", "")

                    print(f"{i}. {title}")
                    print(content)
                    print(f"Джерело: {url}")
                    print("-" * 45)

            except Exception as error:
                print(f"Помилка пошуку: {error}")

    except Exception as error:
        print(f"Не вдалося запустити пошук: {error}")


if __name__ == "__main__":
    main()
