def fetch(url):
    request = urllib.request.Request(
        url,
        headers={"User-Agent": "SimplePythonAssistant/3.0"}
    )

    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            return response.read().decode("utf-8", errors="replace")
    except (urllib.error.URLError, TimeoutError, OSError):
        return None


def normalize(text):
    text = text.lower().replace("ё", "е")
    text = re.sub(r"[^a-zа-яіїєґ0-9 ]", " ", text)
    return " ".join(text.split())


def get_keywords(text):
    words = normalize(text).split()
    return [word for word in words if word not in STOP_WORDS]


def extract_topic(text):
    cleaned = normalize(text)
    patterns = [
        r"^що таке ",
        r"^хто такий ",
        r"^хто така ",
        r"^хто таке ",
        r"^поясни ",
        r"^розкажи про ",
        r"^дай інформацію про ",
        r"^визначення слова "
    ]

    for pattern in patterns:
        cleaned = re.sub(pattern, "", cleaned).strip()

    return cleaned or normalize(text)


def wikipedia_search(query):
    url = "https://uk.wikipedia.org/w/api.php?" + urllib.parse.urlencode({
        "action": "query",
        "list": "search",
        "srsearch": query,
        "format": "json",
        "srlimit": 8
    })

    data = fetch(url)
    if not data:
        return []

    try:
        return json.loads(data).get("query", {}).get("search", [])
    except (ValueError, TypeError):
        return []


def wikipedia_summary(title):
    url = (
        "https://uk.wikipedia.org/api/rest_v1/page/summary/"
        + urllib.parse.quote(title.replace(" ", "_"))
    )

    data = fetch(url)
    if not data:
        return None

    try:
        result = json.loads(data)

        if result.get("type") in ("disambiguation", "no-extract"):
            return None

        extract = result.get("extract", "").strip()
        if len(extract) < 40:
            return None

        return {
            "title": result.get("title", title),
            "text": extract,
            "url": result.get("content_urls", {})
                          .get("desktop", {})
                          .get("page", "")
        }
    except (ValueError, TypeError):
        return None


def score_result(query, title, snippet=""):
    keywords = get_keywords(query)
    title_norm = normalize(title)
    snippet_norm = normalize(snippet)

    if not keywords:
        return 0

    title_words = set(title_norm.split())
    snippet_words = set(snippet_norm.split())

    score = 0

    # Точна відповідність назви темі.
    if title_norm == normalize(query):
        score += 100

    matched_title = sum(word in title_words for word in keywords)
    matched_snippet = sum(word in snippet_words for word in keywords)

    score += 60 * matched_title / len(keywords)
    score += 20 * matched_snippet / len(keywords)

    # Спеціальні ознаки для запитання про людське око.
    if "око" in keywords:
        anatomy_terms = {
            "орган", "зору", "сітківка", "кришталик",
            "рогівка", "зіниця", "анатомія", "людини"
        }

        combined = title_words | snippet_words
        score += 12 * len(anatomy_terms & combined)

        # Назви, які схожі на абревіатури, не повинні
        # автоматично перемагати звичайне значення слова.
        if title.isupper() and len(title) > 1:
            score -= 25

    return score


def search_information(query):
    topic = extract_topic(query)

    # Для коротких або неоднозначних запитів робимо
    # кілька пошуків із контекстними словами.
    search_queries = [topic]

    if normalize(topic) == "око":
        search_queries += [
            "око орган зору людини",
            "око анатомія людини"
        ]

    found = {}
    for search_query in search_queries:
        for item in wikipedia_search(search_query):
            title = item.get("title", "")
            if not title:
                continue

            key = title.casefold()
            if key not in found:
                found[key] = {
                    "title": title,
                    "snippet": re.sub(
                        r"<[^>]+>", "",
                        item.get("snippet", "")
                    )
                }

    candidates = list(found.values())
    candidates.sort(
        key=lambda item: score_result(
            topic, item["title"], item["snippet"]
        ),
        reverse=True
    )

    sources = []

    for item in candidates[:6]:
        source = wikipedia_summary(item["title"])
        if not source:
            continue

        source["score"] = score_result(
            topic, source["title"], source["text"]
        )
        sources.append(source)

    sources.sort(key=lambda item: item["score"], reverse=True)
    return sources


def form_answer(question, sources):
    topic = extract_topic(question)
    topic_norm = normalize(topic)

    # Для цих популярних понять відповідь не залежить
    # від того, яка випадкова стаття випала першою.
    if topic_norm in DEFINITIONS:
        answer = DEFINITIONS[topic_norm]

        if sources and sources[0].get("url"):
            answer += "\n\nДодаткове джерело: " + sources[0]["url"]

        return answer

    if not sources:
        return (
            "Не вдалося знайти відповідну статтю у Вікіпедії. "
            "Перевір підключення до інтернету або уточни запитання."
        )

    best = sources[0]

    if best["score"] < 20:
        return (
            "Я знайшов результати, але не впевнений, що вони "
            "відповідають твоєму запитанню. Спробуй уточнити тему."
        )

    answer = best["text"]

    # Не додаємо випадкові статті лише тому, що в них
    # зустрічається те саме слово.
    if best.get("url"):
        answer += "\n\nДжерело: " + best["url"]

    return answer


def main():
    global last_topic

    print("=" * 50)
    print("MY AI — ПОШУКОВИЙ ПОМІЧНИК")
    print("Без API-ключа та додаткових бібліотек")
    print("Команди: /clear, /history, /exit")
    print("=" * 50)

    while True:
        try:
            text = input("\nТи: ").strip()

            if not text:
                continue

            command = text.lower()

            if command in ("/exit", "/quit", "вихід"):
                print("До зустрічі!")
                break

            if command == "/clear":
                history.clear()
                last_topic = ""
                print("Історію та контекст очищено.")
                continue

            if command == "/history":
                if not history:
                    print("Історія порожня.")
                else:
                    for item in history:
                        print("\nТи:", item["question"])
                        print("MY AI:", item["answer"])
                continue

            topic = extract_topic(text)

            # Прості продовження попередньої теми.
            followups = (
                "а як", "а чому", "а можна", "а він", "а вона",
                "а це", "розкажи більше", "поясни детальніше",
                "детальніше", "продовжуй"
            )

            if last_topic and any(command.startswith(x) for x in followups):
                query = last_topic + " " + text
            else:
                query = topic
                last_topic = topic

            print("\nШукаю інформацію...")
            sources = search_information(query)
            answer = form_answer(query, sources)

            print("\nMY AI:\n" + answer)

            history.append({
                "question": text,
                "answer": answer
            })
            history[:] = history[-20:]

        except KeyboardInterrupt:
            print("\nВведи /exit для виходу.")
        except Exception as error:
            print("\nСталася помилка:", error)
            print("Програма продовжить роботу. Спробуй ще раз.")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        traceback.print_exc()
    finally:
